  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#685656",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Default text / variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable",
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#feffff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#dbded8"
      }
    },
    {
      "name": "Keyword / storage / control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#c06060"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#20b0c0"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template",
        "meta.attribute string"
      ],
      "settings": {
        "foreground": "#40d080"
      }
    },
    {
      "name": "String interpolation / escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "punctuation.definition.template-expression",
        "meta.embedded.line"
      ],
      "settings": {
        "foreground": "#90d050"
      }
    },
    {
      "name": "Number / constant / boolean",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.other.placeholder",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e09040"
      }
    },
    {
      "name": "Constant / enum member",
      "scope": [
        "variable.other.constant",
        "constant.other.caps",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#e0d000"
      }
    },
    {
      "name": "Function / method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e0d000"
      }
    },
    {
      "name": "Class / type / interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#20b0c0"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#e09040"
      }
    },
    {
      "name": "Property / object key",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#00b0c0"
      }
    },
    {
      "name": "Language variable (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "keyword.other.this"
      ],
      "settings": {
        "foreground": "#801070",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Support / built-in library",
      "scope": [
        "support.variable",
        "support.other",
        "support.module"
      ],
      "settings": {
        "foreground": "#0090c0"
      }
    },
    {
      "name": "Decorator / annotation",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#603090"
      }
    },
    {
      "name": "HTML/XML tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#c06060"
      }
    },
    {
      "name": "HTML/XML attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#90d050"
      }
    },
    {
      "name": "CSS selector / id / class",
      "scope": [
        "entity.name.selector",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#e0d000"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#00b0c0"
      }
    },
    {
      "name": "CSS value / unit",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#e09040"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.json string"
      ],
      "settings": {
        "foreground": "#00b0c0"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#e0d000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#e09040",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#c06060",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#20b0c0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown list / quote",
      "scope": [
        "markup.list",
        "beginning.punctuation.definition.list.markdown",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#90d050"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#40d080"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#40d080"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#a03050"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#3060b0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c06060",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#801070",
